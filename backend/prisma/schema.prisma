datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String?        @unique
  phone            String         @unique
  password         String?        // Nullable for simulated Google/OTP login
  role             String         @default("STUDENT") // "STUDENT", "ADMIN", "SUPERADMIN"
  trialStartDate   DateTime       @default(now())
  trialEndDate     DateTime       // Scheduled for 2 days after creation
  xpPoints         Int            @default(0)
  streakCount      Int            @default(0)
  lastActiveDate   DateTime?
  coins            Int            @default(0)
  referralCode     String         @unique
  referredById     String?
  referredBy       User?          @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers    User[]         @relation("UserReferrals")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  subscriptions    Subscription[]
  payments         Payment[]
  bookmarks        Bookmark[]
  testAttempts     TestAttempt[]
  progress         UserProgress[]
  auditLogs        AuditLog[]
}

model Exam {
  id          String      @id @default(uuid())
  name        String      @unique // e.g. "UPSC", "SSC", "Banking"
  description String
  icon        String      // Lucide icon name, e.g. "BookOpen", "Award"
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  subjects    Subject[]
  mockTests   MockTest[]
}

model Subject {
  id          String      @id @default(uuid())
  name        String
  description String
  examId      String
  exam        Exam        @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  chapters    Chapter[]
}

model Chapter {
  id            String      @id @default(uuid())
  name          String
  description   String
  videoUrl      String?
  videoDuration String?
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  topics        Topic[]
}

model Topic {
  id          String      @id @default(uuid())
  name        String
  description String
  chapterId   String
  chapter     Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  questions   Question[]
  notes       Note[]
}

model Question {
  id            String             @id @default(uuid())
  text          String             // Question description (MCQ text)
  options       String             // JSON stringified list of options (e.g. ["A", "B", "C", "D"])
  correctOption Int                // 0-based index of correct option
  explanation   String             // Explanation of correct answer
  difficulty    String             @default("MEDIUM") // "EASY", "MEDIUM", "HARD"
  language      String             @default("English")
  topicId       String
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  isPYQ         Boolean            @default(false)
  pyqYear       Int?               // e.g. 2023, 2022
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  mockQuestions MockTestQuestion[]
  userProgress  UserProgress[]
}

model Note {
  id                String   @id @default(uuid())
  title             String
  content           String   // Markdown/HTML notes content
  pdfUrl            String?  // Optional uploaded PDF path
  isPremium         Boolean  @default(false)
  estimatedReadTime Int      @default(5) // in minutes
  topicId           String
  topic             Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MockTest {
  id              String             @id @default(uuid())
  title           String
  description     String
  durationMinutes Int
  totalMarks      Int
  negativeMarking Float              @default(0.25)
  isPremium       Boolean            @default(false)
  examId          String
  exam            Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  questions       MockTestQuestion[]
  attempts        TestAttempt[]
}

model MockTestQuestion {
  id         String   @id @default(uuid())
  mockTestId String
  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([mockTestId, questionId])
}

model TestAttempt {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTestId       String
  mockTest         MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  score            Float
  correctCount     Int
  incorrectCount   Int
  answers          String   // JSON stringified object matching questionId to selectedOptionIndex
  timeTakenSeconds Int
  completedAt      DateTime @default(now())
}

model CurrentAffairs {
  id            String   @id @default(uuid())
  title         String
  content       String   // Rich Text or Markdown
  date          DateTime @default(now())
  category      String   // National, International, Economy, etc.
  isQuiz        Boolean  @default(false)
  quizQuestions String?  // JSON stringified questions list if it's a quiz mode
  createdAt     DateTime @default(now())
}

model SubscriptionPlan {
  id           String         @id @default(uuid())
  name         String         // e.g. "1 Month Pro", "1 Year Super"
  price        Float
  durationDays Int            // e.g. 30, 90, 365
  description  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   // "ACTIVE", "EXPIRED", "CANCELLED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId   String?  // ID of subscription if successful
  amount           Float
  paymentGatewayId String   // Razorpay order/payment ID
  status           String   // "PENDING", "PAID", "FAILED"
  createdAt        DateTime @default(now())
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "QUESTION", "NOTE", "TEST", "ARTICLE"
  targetId  String   // ID of question, note, test, etc.
  createdAt DateTime @default(now())

  @@unique([userId, type, targetId])
}

model UserProgress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  isCorrect      Boolean
  attempts       Int      @default(1)
  lastAttempted  DateTime @default(now())

  @@unique([userId, questionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  timestamp DateTime @default(now())
}

model Coupon {
  code            String       @id // Uppercase Coupon code, e.g. "EXAM50"
  discountType    String       @default("PERCENTAGE") // "PERCENTAGE", "FLAT"
  value           Float
  minOrderAmount  Float        @default(0.0)
  maxDiscount     Float?
  expiryDate      DateTime
  usageLimit      Int          @default(100)
  usedCount       Int          @default(0)
  createdAt       DateTime     @default(now())
}

model SystemSetting {
  key   String @id
  value String
}

